#include <windows.h>
#include "resource.h"

IDI_POWERSHIFT ICON "PowerShift.ico"
IDR_MANIFEST RT_MANIFEST "PowerShift.manifest"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "PowerShift\0"
      VALUE "FileDescription", "PowerShift - Windows Power Plan Switcher\0"
      VALUE "FileVersion", "1.0.0.0\0"
      VALUE "InternalName", "PowerShift\0"
      VALUE "OriginalFilename", "PowerShift.exe\0"
      VALUE "ProductName", "PowerShift\0"
      VALUE "ProductVersion", "V1.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
